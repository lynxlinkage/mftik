#!/usr/bin/env bash
# E01-D007: install mftiko-conformance from the pinned mftiko commit.
# The commit is the one recorded by scripts/sync-proto in contract/proto/SOURCE.
# Requires Go 1.26 or newer (the pinned module's go directive).
# This does not run the suite. E05 connects execution.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_file="${root}/contract/proto/SOURCE"
commit="$(sed -n 's/^commit=//p' "$source_file")"
if [[ -z "$commit" ]]; then
  echo "commit missing from ${source_file}" >&2
  exit 1
fi

go install "github.com/BullionBear/mftiko/cmd/mftiko-conformance@${commit}"
