# Template for /opt/mftik/deploy/.env on the production host.
#
# The real file is NOT in git and is never overwritten by a deploy — CI only
# rewrites the MFTIK_VERSION line.

# Image tag, rewritten by .github/workflows/deploy.yml to sha-<gitsha>.
MFTIK_VERSION=latest

# Long-lived substrate on DB_HOST. `mftik` is a dedicated database, so
# MFTIK's alembic_version does not collide with the other apps on that server.
DATABASE_URL=postgresql+asyncpg://DB_USER:CHANGEME@DB_HOST:5432/mftik
DATABASE_URL_SYNC=postgresql+psycopg://DB_USER:CHANGEME@DB_HOST:5432/mftik
REDIS_URL=redis://:CHANGEME@DB_HOST:6379/0

# Namespaces every Redis key/stream/subject. Set because this Redis instance is
# shared with other apps on the host.
BROKER_KEY_PREFIX=mftik

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MFTIK_DEFAULT_USER_ID=1

# Real venue credentials. Leave empty to run paper-only; the seed registers a
# Gate api row only when both are set.
GATE_SPOT_API_KEY=
GATE_SPOT_API_SECRET=
