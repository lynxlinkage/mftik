# Template for the .env that sits next to deploy/docker-compose.yml on the
# production host. The real file is NOT in git.

# Image tag to run — a tag published by .github/workflows/release.yml.
MFTIK_VERSION=v0.0.1

# The domain this stack answers on. Traefik routes on it, the frontend takes it
# as ORIGIN, and the API builds its OAuth callback from it, so it is one value
# rather than three. compose refuses to start without it.
MFTIK_DOMAIN=mftik.example.com

# Postgres and Redis are long-lived substrate on a host this stack does not
# manage, shared with other applications. `mftik` is a dedicated database there,
# so its alembic_version does not collide with theirs. Real values live in the
# .env on the host and are deliberately not written down here.
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:5432/mftik
DATABASE_URL_SYNC=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/mftik
REDIS_URL=redis://:REDIS_PASSWORD@REDIS_HOST:6379/0

# Namespaces every Redis key/stream/subject. Set because this Redis instance is
# shared with other apps on the host.
BROKER_KEY_PREFIX=mftik

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MFTIK_DEFAULT_USER_ID=1

# Real venue credentials. Leave empty to run paper-only; the seed registers a
# Gate api row only when both are set.
GATE_SPOT_API_KEY=
GATE_SPOT_API_SECRET=
