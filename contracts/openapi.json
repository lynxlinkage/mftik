            "title": "Passphrase"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          }
        },
        "type": "object",
        "required": [
          "name",
          "venue",
          "api_key",
          "api_secret"
        ],
        "title": "ApiCreateBody",
        "description": "Create a venue API credential and its 1-1 trading account."
      },
