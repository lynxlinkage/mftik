    "/audits": {
      "get": {
        "tags": [
          "audits"
        ],
        "summary": "List Audits",
        "operationId": "list_audits_audits_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
