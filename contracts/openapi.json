  "components": {
    "schemas": {
      "ApiCreateBody": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name"
          },
          "venue": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Venue"
          },
          "api_key": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Api Key"
          },
          "api_secret": {
            "type": "string",
            "minLength": 1,
            "title": "Api Secret"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": "HMAC"
          },
          "passphrase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passphrase"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          }
        },
        "type": "object",
        "required": [
          "name",
          "venue",
          "api_key",
          "api_secret"
        ],
        "title": "ApiCreateBody",
        "description": "Create a venue API credential and its 1-1 trading account."
      },
      "ApiDeleteResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "account_id": {
            "type": "integer",
            "title": "Account Id"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "account_id"
        ],
        "title": "ApiDeleteResponse"
      },
      "ApiListResponse": {
        "properties": {
          "apis": {
            "items": {
              "$ref": "#/components/schemas/ApiOut"
            },
            "type": "array",
            "title": "Apis"
          }
        },
        "type": "object",
        "title": "ApiListResponse"
      },
      "ApiOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "account_id": {
            "type": "integer",
            "title": "Account Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "created_by": {
            "type": "integer",
            "title": "Created By"
          }
        },
        "type": "object",
        "required": [
          "id",
          "account_id",
          "name",
          "venue",
          "api_key",
          "type",
          "created_at",
