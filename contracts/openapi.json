      }
    },
    "/md/sessions": {
      "get": {
        "tags": [
          "md"
        ],
        "summary": "List Sessions",
        "operationId": "list_sessions_md_sessions_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
