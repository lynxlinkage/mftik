            "maxLength": 64,
            "minLength": 1,
            "title": "Venue"
          },
          "api_key": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Api Key"
          },
          "api_secret": {
            "type": "string",
            "minLength": 1,
            "title": "Api Secret"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": "HMAC"
          },
          "passphrase": {
            "anyOf": [
              {
                "type": "string"
