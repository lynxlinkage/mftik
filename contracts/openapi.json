  "components": {
    "schemas": {
      "ApiListResponse": {
        "properties": {
          "apis": {
            "items": {
              "$ref": "#/components/schemas/ApiOut"
            },
            "type": "array",
            "title": "Apis"
          }
        },
        "type": "object",
        "title": "ApiListResponse"
      },
      "ApiOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "id",
          "venue",
          "api_key",
          "type"
        ],
        "title": "ApiOut"
      },
      "AuditListResponse": {
        "properties": {
          "audits": {
            "items": {
              "$ref": "#/components/schemas/AuditOut"
            },
            "type": "array",
            "title": "Audits"
          }
        },
        "type": "object",
        "title": "AuditListResponse"
      },
      "AuditOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "result": {
            "type": "string",
            "title": "Result"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "operation",
          "result"
        ],
        "title": "AuditOut"
      },
      "DeployBody": {
        "properties": {
          "td": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Td"
          },
          "md": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Md"
          },
          "st_paras": {
            "additionalProperties": true,
            "type": "object",
            "title": "St Paras"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          },
          "timeout": {
            "type": "number",
            "title": "Timeout",
            "default": 30.0
          }
        },
        "type": "object",
        "title": "DeployBody",
        "description": "Deployment spec for ``POST /sts/{strategy_id}`` (like deployment.yml)."
      },
      "DeployResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy"
          },
          "td": {
            "items": {
              "$ref": "#/components/schemas/TdAttachOut"
            },
            "type": "array",
            "title": "Td"
          },
          "md": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Md"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "live"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "strategy"
        ],
        "title": "DeployResponse"
      },
      "DomainStats": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "live": {
            "type": "integer",
            "title": "Live",
            "default": 0
          },
          "done": {
            "type": "integer",
            "title": "Done",
            "default": 0
          },
          "healthy": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Healthy"
          }
        },
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "DomainStats"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionListResponse": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionOut"
            },
            "type": "array",
            "title": "Sessions"
          }
        },
        "type": "object",
        "title": "SessionListResponse"
      },
      "SessionOut": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "created_by": {
            "type": "integer",
            "title": "Created By"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "api_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Id"
          },
          "sts_session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sts Session Id"
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          },
          "paused": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paused"
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "domain",
          "created_by",
          "created_at",
          "status"
        ],
        "title": "SessionOut"
      },
      "StatsResponse": {
        "properties": {
          "domains": {
            "items": {
              "$ref": "#/components/schemas/DomainStats"
            },
            "type": "array",
            "title": "Domains"
          }
        },
        "type": "object",
        "required": [
          "domains"
        ],
        "title": "StatsResponse"
      },
      "StrategiesResponse": {
        "properties": {
          "strategies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strategies"
          }
        },
        "type": "object",
        "required": [
          "strategies"
        ],
        "title": "StrategiesResponse"
      },
      "StsControlResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "paused": {
            "type": "boolean",
            "title": "Paused",
            "default": false
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "status"
        ],
        "title": "StsControlResponse"
      },
      "TdAttachOut": {
        "properties": {
          "api_id": {
            "type": "integer",
            "title": "Api Id"
          },
          "refcount": {
            "type": "integer",
            "title": "Refcount"
          }
        },
        "type": "object",
        "required": [
          "api_id",
          "refcount"
        ],
        "title": "TdAttachOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
