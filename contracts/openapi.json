                }
              }
            }
          }
        }
      }
    },
    "/sts/sessions/{session_id}/stop": {
      "post": {
        "tags": [
          "sts"
        ],
        "summary": "Stop Session",
        "operationId": "stop_session_sts_sessions__session_id__stop_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
