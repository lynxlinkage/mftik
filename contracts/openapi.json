    "/sts/sessions": {
      "get": {
        "tags": [
          "sts"
        ],
        "summary": "List Sessions",
        "operationId": "list_sessions_sts_sessions_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "live",
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
