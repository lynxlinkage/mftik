REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://mftik:mftik@postgres:5432/mftik
DATABASE_URL_SYNC=postgresql+psycopg://mftik:mftik@postgres:5432/mftik
POSTGRES_USER=mftik
POSTGRES_PASSWORD=mftik
POSTGRES_DB=mftik
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
API_PROXY_TARGET=http://api:8000
# Frontend process → API, no /api prefix. adapter-node uses this for the
# document gate (`+layout.server.ts`). Vite falls back to API_PROXY_TARGET.
API_INTERNAL_URL=http://api:8000
MFTIK_DEFAULT_USER_ID=1
MFTIK_DATA=.mft
# In-app auth (docs/Auth.md). Off means every request is MFTIK_DEFAULT_USER_ID,
# which is what the API has always done. docker-compose.yml turns it on for the
# local api service; production keeps it off until the Traefik chain in front of
# it comes off, because running both gates locks everybody out.
MFTIK_AUTH_ENABLED=0
# Local development is plain http, and Safari drops Secure cookies there.
# Production must leave this on.
MFTIK_COOKIE_SECURE=0
# Origins allowed to make credentialed cross-origin requests. Empty is correct
# for every deployment here: the Vite proxy makes local same-origin, and
# production serves the document, /api and /ws from one hostname — and
# same-origin requests never consult CORS. Only a deployment that genuinely
# splits the UI onto another host needs to name it, and it must name it: a
# session cookie is at stake, so the wildcard is not an option.
MFTIK_ALLOWED_ORIGINS=

# Discord OAuth (docs/Auth.md step 5). All three must be set before the
# provider is offered at all — an unconfigured one is simply not listed rather
# than failing halfway through a flow.
#
# The redirect base is the origin *the browser* reaches this API on, prefix
# included. It cannot be derived from the request: Traefik strips /api in
# production and the Vite proxy strips it locally, so the API's own view of
# its URL is exactly the one Discord must not be given. Register the same
# value as a redirect URI on the Discord application, with
# /auth/callback/discord on the end.
MFTIK_OAUTH_REDIRECT_BASE=http://localhost:5173/api
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google, same shape. Its redirect URI is the same base with
# /auth/callback/google on the end, registered on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
