REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://mft:mft@postgres:5432/mft
DATABASE_URL_SYNC=postgresql+psycopg://mft:mft@postgres:5432/mft
POSTGRES_USER=mft
POSTGRES_PASSWORD=mft
POSTGRES_DB=mft
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
API_PROXY_TARGET=http://api:8000
MFT_DEFAULT_USER_ID=1
MFT_DATA=.mft
# In-app auth (docs/Auth.md). Off means every request is MFT_DEFAULT_USER_ID,
# which is what the API has always done. docker-compose.yml turns it on for the
# local api service; production keeps it off until the Traefik chain in front of
# it comes off, because running both gates locks everybody out.
MFT_AUTH_ENABLED=0
# Local development is plain http, and Safari drops Secure cookies there.
# Production must leave this on.
MFT_COOKIE_SECURE=0
