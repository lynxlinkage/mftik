{
  "artifactVersion": "set-by-tag",
  "deployPolicy": {
    "startsecs": 5,
    "healthWindowSeconds": 90,
    "maxCrashesInWindow": 3,
    "stopGraceSeconds": 15,
    "enableAutoRollback": true
  },
  "secretKeysFromProdEnv": [
    "DATABASE_URL",
    "DATABASE_URL_SYNC"
  ],
  "commonEnv": {
    "BROKER_KEY_PREFIX": "mftik",
    "LOG_LEVEL": "INFO",
    "MFTIK_DEFAULT_USER_ID": "1"
  },
  "planes": [
    {
      "machineId": "cp",
      "strategy": "td",
      "args": ["td"],
      "nats": "nats://100.108.10.2:4222",
      "instance": "td"
    },
    {
      "machineId": "cp",
      "strategy": "md",
      "args": ["md"],
      "nats": "nats://100.108.10.2:4222",
      "instance": "md",
      "env": {
        "MD_TAPE_TOPICS": "aggtrade",
        "MD_TAPE_RETENTION_S": "7200",
        "MD_TAPE_MAXLEN": "150000"
      }
    },
    {
      "machineId": "cp",
      "strategy": "sts",
      "args": ["sts"],
      "nats": "nats://100.108.10.2:4222",
      "instance": "sts",
      "env": {
        "MFTIK_DATA": "/var/lib/mftik",
        "STS_REBUILD_ON_BOOT": "1",
        "STS_EVENTLOG_DIR": "/var/log/mftik/sts",
        "STS_EVENTLOG_QUEUE": "20000",
        "STS_EVENTLOG_MAX_BYTES": "134217728",
        "STS_EVENTLOG_BACKUPS": "2"
      }
    },
    {
      "machineId": "yite",
      "strategy": "td-2",
      "args": ["td"],
      "nats": "nats://100.65.26.119:4222",
      "instance": "td-2"
    },
    {
      "machineId": "yite",
      "strategy": "md-2",
      "args": ["md"],
      "nats": "nats://100.65.26.119:4222",
      "instance": "md-2",
      "env": {
        "MD_TAPE_TOPICS": "aggtrade",
        "MD_TAPE_RETENTION_S": "7200",
        "MD_TAPE_MAXLEN": "150000"
      }
    },
    {
      "machineId": "yite",
      "strategy": "sts-2",
      "args": ["sts"],
      "nats": "nats://100.65.26.119:4222",
      "instance": "sts-2",
      "env": {
        "MFTIK_DATA": "/var/lib/mftik",
        "STS_REBUILD_ON_BOOT": "1",
        "STS_EVENTLOG_DIR": "/var/log/mftik/sts",
        "STS_EVENTLOG_QUEUE": "20000",
        "STS_EVENTLOG_MAX_BYTES": "134217728",
        "STS_EVENTLOG_BACKUPS": "2"
      }
    },
    {
      "machineId": "yite",
      "strategy": "sym",
      "args": ["sym"],
      "nats": "nats://100.65.26.119:4222",
      "env": {
        "SYM_REFRESH_INTERVAL": "3600"
      }
    },
    {
      "machineId": "yite",
      "strategy": "paper",
      "args": ["paper"],
      "nats": "nats://100.65.26.119:4222"
    }
  ]
}
